# Data & artifacts (runtime)
data/
gx1/wf_runs/
# But keep inventory files for reference (they're small)
!gx1/wf_runs/_inventory.json
!gx1/wf_runs/_inventory.csv
# Archive directory
gx1/wf_runs/_archive/
archive/REPLAY_RAW_*/
gx1/live/
gx1/live/logs/
logs/
gx1/optuna/**/*.db

# Runtime data directories (permanent exclusion)
runs/
outputs/
data/replay/
data/temp/

# Replay eval: Ignore DERIVAT artifacts, but keep SSoT reports
reports/replay_eval/**/chunk_*/
reports/replay_eval/**/chunks/
reports/replay_eval/**/intratrade/
reports/replay_eval/**/raw/
reports/replay_eval/**/perf_*.json
reports/replay_eval/**/trade_journal/

# Large binary files (permanent exclusion)
*.parquet
*.pt
*.joblib
*.csv
*.sqlite
# Exception: Keep prebuilt feature manifests (small JSON files)
!data/prebuilt/**/*.manifest.json

# Large log/telemetry files
*.jsonl
*.log

# Python cache
__pycache__/
*.pyc

# Environments
.env
.env.*

# Installer scripts / heavy binaries
Miniforge3.sh

# OS junk
.DS_Store

# Exit router training datasets (already covered by *.parquet and *.csv above)
# gx1/data/exit_router/*.parquet
# gx1/data/exit_router/*.csv


# Quarantine directories (legacy cleanup)
_quarantine_*/

# GX1_DATA (external data directory - never commit)
../GX1_DATA/
GX1_DATA/

# Data directories (root-level only — keep gx1/models/ source code tracked)
/data/
/models/
/reports/
/archive/
/quarantine/

# Large binary/model files
**/*.parquet
**/*.joblib
**/*.pkl
**/*.bst
**/*.sqlite
**/*.db
**/*.pt
**/*.onnx
**/*.npy
**/*.npz
**/optuna*.db

# OS and cache
**/.DS_Store
**/__pycache__/
**/*.log

# Temporary files
$TEMP_DATA_2D
0

# local venvs
.venv/
venv/
__pycache__/
*.pyc

# data/artifacts
*.parquet
*.joblib
*.pt
*.pth
*.onnx
*.zip
*.tgz
*.tar.gz

# reports/logs
GX1_DATA/
reports/
