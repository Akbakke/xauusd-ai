#!/usr/bin/env bash
# Tracked, version-controlled pre-commit gate (activated via: git config core.hooksPath .claude/git-hooks).
# Forward-workflow guardrail: a commit cannot land if the versioned guards or
# model-native Entry contracts drift.
set -euo pipefail

PY=.venv/bin/python
[ -x "$PY" ] || { echo "[pre-commit] ERROR: canonical $PY is missing" >&2; exit 1; }

# 1) Guardrail drift tripwire (fast, always): live ~/.claude hooks/settings must match the versioned refs.
if ! "$PY" -m pytest tests/test_guard_hooks_versioned.py -q >/tmp/gx1_precommit_drift.log 2>&1; then
  echo "[pre-commit] GUARDRAIL DRIFT — commit blocked. See /tmp/gx1_precommit_drift.log" >&2
  tail -5 /tmp/gx1_precommit_drift.log >&2 || true
  exit 1
fi

# 2) Exact model-native contracts — only when Entry model/contract/serving code
# is staged, keeping unrelated commits fast without weakening this boundary.
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -qE 'gx1/models/entry_v10/|gx1/contracts/|gx1/execution/v12_(smart_entry_live|model_native_state_live|pipeline)\.py|gx1/scripts/(build_entry_v10|evaluate_entry_candidate|verify_model_native_serve_parity)'; then
  echo "[pre-commit] model-native Entry boundary staged → running exact contract tests…"
  if ! "$PY" -m pytest -q \
      tests/test_entry_model_native_signal_contract.py \
      tests/test_entry_v10_direction_decision_contract.py \
      tests/test_entry_model_native_sizing_authority.py \
      >/tmp/gx1_precommit_model_native.log 2>&1; then
    echo "[pre-commit] MODEL-NATIVE CONTRACTS FAILED — commit blocked. See /tmp/gx1_precommit_model_native.log" >&2
    tail -12 /tmp/gx1_precommit_model_native.log >&2 || true
    exit 1
  fi
fi

echo "[pre-commit] guardrails OK"
exit 0
