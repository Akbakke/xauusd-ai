# GX1 OANDA practice credentials.
# Copy to .env and replace only the credential placeholders. This file does not
# authorize Entry, paper trading or live trading; the immutable launch state is
# currently BLOCK and remains authoritative.
OANDA_ENV=practice
OANDA_API_TOKEN=replace_with_practice_token
OANDA_ACCOUNT_ID=replace_with_practice_account_id

# Optional notifier credentials.
GX1_TELEGRAM_BOT_TOKEN=
GX1_TELEGRAM_CHAT_ID=

# Entry direction, trend/session/utility filtering, thresholds and position
# sizing have no environment-variable control surface. They come only from an
# admitted model plus exact immutable evidence; missing proof means NO_ORDER.
